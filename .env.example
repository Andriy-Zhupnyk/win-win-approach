# Environment variables for Win-Win Approach.
#
# Copy this file to `.env.local` and fill in real values there. `.env.local`
# is gitignored and must never be committed.

# Postgres connection string used by Prisma (schema.prisma, `prisma migrate`,
# `npm run db:seed`, and the app's Prisma client).
#
# For local development, run `docker compose up -d` (see docker-compose.yml /
# README.md) to start a local postgres:16 container, then use:
#   DATABASE_URL="postgresql://winwin:winwin@localhost:5432/winwin?schema=public"
#
# For the hosted demo (Vercel + Neon, see README "Deploying the demo"), the
# Vercel *Production* environment uses Neon's POOLED connection string (host
# contains "-pooler") with `?sslmode=require&pgbouncer=true`. Migrations and
# the owner scripts use Neon's DIRECT (non-pooled) string instead: export it as
# DATABASE_URL in your shell for that one command; do not store it in a file.
DATABASE_URL="postgresql://winwin:winwin@localhost:5432/winwin?schema=public"

# Auth.js (NextAuth v5) session signing secret (spec 0003). Generate a real
# value for your own .env.local with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit a real value here or anywhere else.
AUTH_SECRET=

# --- Hosted demo only (set in the Vercel dashboard, Production scope only) ----
# DATABASE_URL and AUTH_SECRET are the only variables the app needs on Vercel.
# AUTH_TRUST_HOST / AUTH_URL are NOT needed there: Auth.js trusts the host
# automatically when the VERCEL variable is present. Leave them unset.

# --- Owner scripts only (never read by the app; export in your shell) ----------
# `npm run db:seed:demo` sets the member/expert demo passwords from this. It
# refuses to run if it is missing. Choose a value yourself; keep it in a
# password manager.
DEMO_ACCOUNTS_PASSWORD=
# Optional default for `npm run admin:create` (otherwise pass the email as an
# argument or type it at the prompt). The administrator password is never read
# from the environment: it is typed at a hidden prompt.
ADMIN_EMAIL=
